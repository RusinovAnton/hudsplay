{
  "name": "hudsplay-shell",
  "private": true,
  "version": "0.1.8",
  "productName": "HUDsplay",
  "description": "HUDsplay iRacing HUD overlay",
  "author": "RusinovAnton",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.hudsplay.app",
    "productName": "HUDsplay",
    "directories": {
      "output": "../packaging/installer",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/icon.ico"
    ],
    "extraResources": [
      {
        "from": "../packaging/dist/hudsplay-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HUDsplay",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "assets/installer.nsh",
      "artifactName": "hudsplay-setup.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
