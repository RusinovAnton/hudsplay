{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hudsplay-mock",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "hudsplay",
        "--mock",
        "--port",
        "8767"
      ],
      "port": 8767
    },
    {
      "name": "website",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--no-sync",
        "python",
        "-m",
        "http.server",
        "8790",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs"
      ],
      "port": 8790
    }
  ]
}
