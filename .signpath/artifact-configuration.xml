<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration for the racehud project: paste into the project's
     artifact configuration in SignPath. The GitHub Actions artifact (release.yml,
     "racehud-setup-unsigned") is a zip holding the NSIS installer; sign that exe. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="racehud-setup.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
